{
  "name": "@fixwire/nuxt",
  "version": "0.1.3",
  "description": "Fixwire SDK for Nuxt: a module for the browser and the server, with Vue's and Nitro's errors and routes as names",
  "keywords": [
    "fixwire",
    "error-monitoring",
    "error-tracking",
    "tracing",
    "observability",
    "nuxt",
    "nuxt-module",
    "nitro",
    "vue"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fixwire/fixwire-js/tree/main/packages/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixwire/fixwire-js.git",
    "directory": "packages/nuxt"
  },
  "bugs": "https://github.com/fixwire/fixwire-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "fixwire-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@nuxt/schema": ">=3.13",
    "vue": ">=3.3"
  },
  "dependencies": {
    "@fixwire/core": "workspace:*",
    "@fixwire/node": "workspace:*",
    "@fixwire/vue": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

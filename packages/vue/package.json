{
  "name": "@fixwire/vue",
  "version": "0.2.0",
  "description": "Fixwire SDK for Vue: the errors Vue catches, with their component, and vue-router's routes as page names",
  "keywords": [
    "fixwire",
    "error-monitoring",
    "error-tracking",
    "tracing",
    "observability",
    "vue",
    "vue-router"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fixwire/fixwire-js/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixwire/fixwire-js.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/fixwire/fixwire-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "fixwire-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "fixwire-source": "./src/shared.ts",
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "@fixwire/browser": "workspace:*",
    "@fixwire/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

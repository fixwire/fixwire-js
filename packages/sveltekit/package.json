{
  "name": "@fixwire/sveltekit",
  "version": "0.1.3",
  "description": "Fixwire SDK for SvelteKit: server and browser errors, route names, from one import",
  "keywords": [
    "fixwire",
    "error-monitoring",
    "error-tracking",
    "tracing",
    "observability",
    "svelte",
    "sveltekit"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fixwire/fixwire-js/tree/main/packages/sveltekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixwire/fixwire-js.git",
    "directory": "packages/sveltekit"
  },
  "bugs": "https://github.com/fixwire/fixwire-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/universal.d.ts",
  "exports": {
    ".": {
      "fixwire-source": {
        "types": "./src/universal.ts",
        "browser": "./src/client.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/universal.d.ts",
      "browser": "./dist/client.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "fixwire-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "fixwire-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "fixwire-source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@fixwire/browser": "workspace:*",
    "@fixwire/core": "workspace:*",
    "@fixwire/node": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

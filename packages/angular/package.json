{
  "name": "@fixwire/angular",
  "version": "0.1.3",
  "description": "Fixwire SDK for Angular: an ErrorHandler, HttpClient failures and the Router's routes as page names",
  "keywords": [
    "fixwire",
    "error-monitoring",
    "error-tracking",
    "tracing",
    "observability",
    "angular"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fixwire/fixwire-js/tree/main/packages/angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixwire/fixwire-js.git",
    "directory": "packages/angular"
  },
  "bugs": "https://github.com/fixwire/fixwire-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "fixwire-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@angular/core": ">=20",
    "@angular/router": ">=20"
  },
  "dependencies": {
    "@fixwire/browser": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

    "build": "node scripts/build.mjs",
    "pack-check": "node scripts/pack-check.mjs",
    "typecheck:consumer": "tsc -p types-test && tsc -p types-test/tsconfig.bundler.json",
    "size": "node scripts/size.mjs",
    "license-gate": "node scripts/licenses.mjs",
    "lint": "biome ci .",
    "smoke": "node scripts/smoke.mjs"

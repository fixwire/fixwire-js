    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
